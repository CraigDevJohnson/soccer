# Where the dev deployment keeps its state: the site's state bucket (the-lobby
# infra/bootstrap), under a key of its own, with the bucket's native lock file.
bucket = "craigdevjohnson-tofu-state-793680745829"
key    = "soccer/dev/terraform.tfstate"
region = "us-west-2"

# Workspaces are listed under the deployment's own prefix, the only one its
# deploy role may list (infra/bootstrap). The default workspace, the only one
# used, keeps the key above.
workspace_key_prefix = "soccer/dev"
