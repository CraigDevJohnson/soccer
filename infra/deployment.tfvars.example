# Copy to infra/deployment.<env>.tfvars (gitignored; deployment.dev.tfvars for
# the dev site, deployment.prod.tfvars for production) and replace every
# example with the private value; see docs/operations/deploy.md. Never commit
# real values.

account_id = "111122223333" # the workloads account

# The site this backend serves: its environment, its Lambda role (the only
# caller the Function URL accepts) and where it serves Session links.
site_environment = "dev"
site_role_arn    = "arn:aws:iam::111122223333:role/site-dev-server"
link_base_url    = "https://site.example.com/soccer/link/"

# The account's alerts topic (aws-design.md section 7); the alarms notify it.
alert_topic_arn = "arn:aws:sns:us-west-2:111122223333:alerts"

# The site's cost tag, so its budget covers this backend too.
tags = { Site = "site.example.com" }

# Optional. The league's schedule service and the Facility, when not Boise
# at the service the code knows (README).
# league_base_url    = "https://league.example.com"
# league_facility_id = "4"

# Set by `task infra:plan` from the zip `task lambda` built; needed only when
# running tofu by hand.
# package_path = "/absolute/path/to/soccer/dist/soccer.zip"
