# Go
/bin/
/dist/
*.test
coverage.out

# Local secrets and env
.env
.env.*

# OpenTofu: local data, state and plans. Each deployment's inputs are
# committed under infra/environments/; any other tfvars or backend file is a
# local experiment and stays out.
.terraform/
.terraform.*/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!/infra/environments/*.tfvars
backend.hcl
backend.*.hcl

# Provider selections are committed so CI pins the same versions
!.terraform.lock.hcl

# OS / editors
.DS_Store
