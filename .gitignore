# Go
/bin/
/dist/
*.test
coverage.out

# Collector's pinned Bruno runtime; installed locally with collector:setup.
/scripts/boise_collect/bruno/node_modules/

# Local secrets and env
.env
.env.*

# OpenTofu: local data, state and plans. Each deployment's inputs are
# committed under infra/environments/; any other tfvars or backend file is a
# local experiment and stays out.
.terraform/
.terraform.*/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!/infra/environments/*.tfvars
backend.hcl
backend.*.hcl

# Provider selections are committed so CI pins the same versions
!.terraform.lock.hcl

# OS / editors
.DS_Store

# Local Python collector bytecode (datasets/reports belong under dist/)
__pycache__/
*.py[cod]

# Archive payloads, evidence and generated coverage belong outside source control.
collector.sqlite3
collector.sqlite3-*
collector.lock
archive.tar.gz
evidence.sha256
**/evidence/*.json
**/reports/coverage.json
**/reports/coverage.md
